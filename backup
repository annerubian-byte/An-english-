            'float-delayed': 'float 4s ease-in-out infinite 1s',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0)' },
              '50%': { transform: 'translateY(-8px)' },
            }
          }
        }
      }
    }
  </script>
  <style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    body { background-image: radial-gradient(#EFE5D2 1px, transparent 1px); background-size: 20px 20px; }
  </style>
</head>

<body class="bg-cottage-cream text-cottage-brown min-h-screen font-sans flex flex-col selection:bg-cottage-roseLight selection:text-cottage-roseDark relative pb-10 select-none" oncopy="return false;" oncut="return false;" oncontextmenu="return false;">

  <!-- MÀN HÌNH CHỜ ĐỒNG BỘ DỮ LIỆU LẦN ĐẦU -->
  <div id="sync-overlay" class="fixed inset-0 bg-cottage-cream z-[100] flex flex-col items-center justify-center hidden">
    <div class="text-6xl animate-bounce mb-4">🌷</div>
    <h2 class="text-2xl font-display font-black text-cottage-brown">Đang đồng bộ dữ liệu...</h2>
    <p class="text-sm text-cottage-brownLight mt-2 text-center max-w-xs">Cozy Garden đang sắp xếp tài liệu lên Đám mây cho lần mở đầu tiên. Vui lòng đợi vài giây nhé! ✨</p>
  </div>

  <header class="bg-cottage-card/90 backdrop-blur-md border-b-2 border-dashed border-cottage-butter sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3 cursor-pointer group" onclick="switchNav('cinema')">
        <div class="w-11 h-11 rounded-full bg-cottage-cream border-2 border-cottage-rose/30 flex items-center justify-center text-xl overflow-hidden shadow-sm group-hover:scale-105 transition transform">
        🌷
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-serif italic font-bold text-[24px] text-cottage-roseDark">Cozy garden</span>
          </div>
          <span class="text-[11px] text-cottage-brownLight font-semibold">Cùng chill và học từ vựng qua ngữ cảnh với Cozy nha! 🦢</span>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <button id="vip-header-btn" onclick="openLoginModal()" class="bg-white border-2 border-cottage-rose text-cottage-roseDark hover:bg-cottage-rose hover:text-white text-xs font-black px-4 py-2 rounded-full shadow-[0_4px_15px_rgba(230,164,180,0.2)] transition transform active:scale-95 flex items-center gap-1.5 animate-float">
          <i class="fa-solid fa-spinner fa-spin text-[11px]"></i> <span>Đang tải...</span>
        </button>
      </div>
    </div>
  </header>

  <div class="bg-transparent pt-4 pb-2 z-30">
    <div class="max-w-6xl mx-auto px-4 flex gap-3 overflow-x-auto hide-scrollbar">
      <button onclick="switchNav('cinema')" id="nav-cinema" class="px-5 py-2 rounded-2xl font-display font-bold text-xs bg-cottage-rose text-white shadow-sm transition flex items-center gap-2 shrink-0">
        <i class="fa-solid fa-film"></i> Kho phim
      </button>
      <button onclick="switchNav('music')" id="nav-music" class="px-5 py-2 rounded-2xl font-display font-bold text-xs bg-white border-2 border-cottage-butter text-cottage-brownLight hover:border-cottage-roseLight hover:text-cottage-rose transition flex items-center gap-2 shrink-0">
        <i class="fa-solid fa-headphones"></i> Kho nhạc
      </button>
      <button onclick="switchNav('youtube')" id="nav-youtube" class="px-5 py-2 rounded-2xl font-display font-bold text-xs bg-white border-2 border-cottage-butter text-cottage-brownLight hover:border-cottage-roseLight hover:text-cottage-rose transition flex items-center gap-2 shrink-0">
        <i class="fa-brands fa-youtube"></i> Kho YouTube
      </button>
      <button onclick="switchNav('arcade')" id="nav-arcade" class="px-5 py-2 rounded-2xl font-display font-bold text-xs bg-white border-2 border-cottage-butter text-cottage-brownLight hover:border-cottage-roseLight hover:text-cottage-rose transition flex items-center gap-2 shrink-0">
        <i class="fa-solid fa-puzzle-piece"></i> Trạm luyện tập tổng hợp
      </button>
      <button onclick="switchNav('about')" id="nav-about" class="px-5 py-2 rounded-2xl font-display font-bold text-xs bg-white border-2 border-cottage-butter text-cottage-brownLight hover:border-cottage-roseLight hover:text-cottage-rose transition flex items-center gap-2 shrink-0">
        <i class="fa-solid fa-leaf"></i> Giới thiệu 
      </button>
    </div>
  </div>

  <main class="flex-1 max-w-6xl w-full mx-auto p-4 md:p-6 space-y-8">

    <!-- ================= SECTION: KHO PHIM ================= -->
    <section id="view-cinema" class="space-y-6">
      <div class="bg-gradient-to-br from-cottage-card to-cottage-roseLight/30 border-2 border-dashed border-cottage-rose/40 rounded-[2rem] p-6 md:p-8 relative overflow-hidden shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <i class="fa-solid fa-leaf absolute top-6 left-10 text-4xl text-cottage-green/5 -rotate-12 z-0"></i>
        <i class="fa-solid fa-seedling absolute bottom-4 left-1/3 text-5xl text-cottage-green/10 rotate-12 z-0"></i>
        <i class="fa-solid fa-spa absolute top-1/2 right-1/4 text-6xl text-cottage-rose/10 -rotate-12 z-0"></i>
        <div class="absolute -top-10 -left-10 w-32 h-32 bg-cottage-butter rounded-full blur-3xl opacity-60 z-0"></div>
        <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-cottage-rose rounded-full blur-3xl opacity-20 z-0"></div>

        <div class="space-y-2 z-10 relative">
          <h2 class="text-2xl md:text-3xl font-display font-black text-cottage-brown tracking-tight">Học qua phim ảnh</h2>
          <p class="text-xs md:text-sm text-cottage-brownLight max-w-xl leading-relaxed">Hãy để hình ảnh và cảm xúc từ những bộ phim điện ảnh kinh điển giúp bạn ghim chặt từ vựng vào trí nhớ!</p>
        </div>
        
        <div class="w-16 h-16 md:w-20 md:h-20 bg-white/60 backdrop-blur-md border-[3px] border-white rounded-full flex items-center justify-center text-2xl md:text-3xl animate-float-delayed select-none z-10 relative shadow-[0_8px_30px_rgb(230,164,180,0.3)] text-cottage-roseDark">
          <i class="fa-solid fa-film"></i>
        </div>
      </div>

      <div id="cinema-filters-container" class="flex flex-col md:flex-row gap-2 items-center justify-between bg-cottage-roseLight/10 p-3 rounded-2xl border-2 border-cottage-rose/30 shadow-sm overflow-hidden">
        <div class="flex gap-2 overflow-x-auto hide-scrollbar pb-1 w-full" id="cinema-filters">
          <button onclick="filterSection('cinema', 'ALL')" class="filter-btn active shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-black bg-cottage-roseDark text-white transition shadow-sm">Tất cả thể loại (All)</button>
          <button onclick="filterSection('cinema', 'Romance')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Tình cảm (Romance) 💌</button>
          <button onclick="filterSection('cinema', 'Drama')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Chính kịch (Drama) 🎭</button>
          <button onclick="filterSection('cinema', 'Comedy')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Hài (Comedy) 😂</button>
          <button onclick="filterSection('cinema', 'Musical')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Nhạc kịch (Musical) 🎵</button>
          <button onclick="filterSection('cinema', 'Fantasy')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Kỳ ảo (Fantasy) 🧚‍♀️</button>
          <button onclick="filterSection('cinema', 'Action')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Hành động (Action) 💥</button>
          <button onclick="filterSection('cinema', 'Sci-Fi')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Khoa học viễn tưởng (Sci-Fi) 🛸</button>
          <button onclick="filterSection('cinema', 'Mystery & Thriller')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Trinh thám & giật gân (Mystery & Thriller) 🔍</button>
          <button onclick="filterSection('cinema', 'Documentary')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Tài liệu (Documentary) 🌍</button>
        </div>
        <span class="text-[11px] text-cottage-roseDark font-bold bg-cottage-roseLight px-3 py-1 rounded-full whitespace-nowrap mt-2 md:mt-0 shrink-0"><span id="cinema-count">0</span> bài học 📚</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="cinema-grid"></div>
    </section>

    <!-- ================= SECTION: KHO NHẠC ================= -->
    <section id="view-music" class="hidden space-y-6">
      <div class="bg-gradient-to-br from-cottage-card to-cottage-amber/20 border-2 border-dashed border-cottage-amber/40 rounded-[2rem] p-6 md:p-8 relative overflow-hidden shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <i class="fa-solid fa-music absolute top-6 left-10 text-4xl text-cottage-amber/10 -rotate-12 z-0"></i>
        <i class="fa-solid fa-record-vinyl absolute bottom-4 left-1/3 text-5xl text-cottage-brown/5 rotate-12 z-0"></i>
        <div class="absolute -top-10 -left-10 w-32 h-32 bg-cottage-amber rounded-full blur-3xl opacity-20 z-0"></div>

        <div class="space-y-2 z-10 relative">
          <h2 class="text-2xl md:text-3xl font-display font-black text-cottage-brown tracking-tight">Học qua lời bài hát</h2>
          <p class="text-xs md:text-sm text-cottage-brownLight max-w-xl leading-relaxed">Phân tích những thành ngữ, ẩn dụ và cấu trúc câu thú vị ẩn giấu trong những bài hát nổi tiếng.</p>
        </div>
        
        <div class="w-16 h-16 md:w-20 md:h-20 bg-white/60 backdrop-blur-md border-[3px] border-white rounded-full flex items-center justify-center text-2xl md:text-3xl animate-float select-none z-10 relative shadow-[0_8px_30px_rgb(230,184,125,0.3)] text-cottage-amber">
          <i class="fa-solid fa-headphones-simple"></i>
        </div>
      </div>

      <div id="music-filters-container" class="flex flex-col md:flex-row gap-2 items-center justify-between bg-cottage-amber/10 p-3 rounded-2xl border-2 border-cottage-amber/30 shadow-sm overflow-hidden">
        <div class="flex gap-2 overflow-x-auto hide-scrollbar pb-1 w-full" id="music-filters">
          <button onclick="filterSection('music', 'ALL')" class="filter-btn active shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-black bg-cottage-amberDark text-white transition shadow-sm">Tất cả chủ đề (All)</button>
          <button onclick="filterSection('music', 'Pop')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Nhạc Pop (Pop) 🎤</button>
          <button onclick="filterSection('music', 'Folk & Country')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Đồng quê (Folk & Country) 🌾</button>
          <button onclick="filterSection('music', 'Indie')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Độc lập (Indie) 🎸</button>
          <button onclick="filterSection('music', 'R&B')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Nhạc R&B (R&B) 🎷</button>
          <button onclick="filterSection('music', 'EDM')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Điện tử (EDM) 🎛️</button>
          <button onclick="filterSection('music', 'Soundtrack')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Nhạc phim (Soundtrack) 🎬</button>
        </div>
        <span class="text-[11px] text-cottage-amberDark font-bold bg-cottage-amber/20 px-3 py-1 rounded-full whitespace-nowrap mt-2 md:mt-0 shrink-0"><span id="music-count">0</span> bài hát 🎧</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="music-grid"></div>
    </section>

    <!-- ================= SECTION: KHO YOUTUBE ================= -->
    <section id="view-youtube" class="hidden space-y-6">
      <div class="bg-gradient-to-br from-cottage-card to-cottage-greenLight border-2 border-dashed border-cottage-green/30 rounded-[2rem] p-6 md:p-8 relative overflow-hidden shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <i class="fa-brands fa-youtube absolute top-6 left-10 text-5xl text-cottage-green/10 -rotate-12 z-0"></i>
        <i class="fa-solid fa-clapperboard absolute bottom-4 left-1/3 text-5xl text-cottage-green/10 rotate-12 z-0"></i>
        <div class="absolute -top-10 -left-10 w-32 h-32 bg-cottage-greenLight rounded-full blur-3xl opacity-60 z-0"></div>

        <div class="space-y-2 z-10 relative">
          <h2 class="text-2xl md:text-3xl font-display font-black text-cottage-brown tracking-tight">Học qua video thực tế</h2>
          <p class="text-xs md:text-sm text-cottage-brownLight max-w-xl leading-relaxed">Nắm bắt ngữ điệu tự nhiên, từ lóng và cách diễn đạt trong các bài phỏng vấn, vlog, show truyền hình thực tế.</p>
        </div>
        
        <div class="w-16 h-16 md:w-20 md:h-20 bg-white/60 backdrop-blur-md border-[3px] border-white rounded-full flex items-center justify-center text-2xl md:text-3xl animate-float-delayed select-none z-10 relative shadow-[0_8px_30px_rgb(142,168,133,0.3)] text-cottage-greenDark">
          <i class="fa-solid fa-play"></i>
        </div>
      </div>

      <div id="youtube-filters-container" class="flex flex-col md:flex-row gap-2 items-center justify-between bg-cottage-greenLight/30 p-3 rounded-2xl border-2 border-cottage-green/30 shadow-sm overflow-hidden">
        <div class="flex gap-2 overflow-x-auto hide-scrollbar pb-1 w-full" id="youtube-filters">
          <button onclick="filterSection('youtube', 'ALL')" class="filter-btn active shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-black bg-cottage-greenDark text-white transition shadow-sm">Tất cả chủ đề (All)</button>
          <button onclick="filterSection('youtube', 'News')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Tin tức (News) 📰</button>
          <button onclick="filterSection('youtube', 'Interview')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Phỏng vấn (Interview) 🎙️</button>
          <button onclick="filterSection('youtube', 'Talkshow')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Trò chuyện (Talkshow) 🛋️</button>
          <button onclick="filterSection('youtube', 'Speech')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Diễn văn (Speech) 🎓</button>
          <button onclick="filterSection('youtube', 'Vlog')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Vlog 📹</button>
          <button onclick="filterSection('youtube', 'Reality Show')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Truyền hình thực tế (Reality show) 🏆</button>
          <button onclick="filterSection('youtube', 'Education')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Giáo dục (Education) 📚</button>
          <button onclick="filterSection('youtube', 'Lifestyle')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Phong cách sống (Lifestyle) 🌿</button>
          <button onclick="filterSection('youtube', 'Self-help')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Phát triển bản thân (Self-help) 💡</button>
          <button onclick="filterSection('youtube', 'Beauty / Fashion')" class="filter-btn shrink-0 whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold bg-cottage-cream text-cottage-brown hover:bg-cottage-butter transition">Thời trang / Làm đẹp (Beauty / Fashion) 💄</button>
        </div>
        <span class="text-[11px] text-cottage-greenDark font-bold bg-cottage-greenLight px-3 py-1 rounded-full whitespace-nowrap mt-2 md:mt-0 shrink-0"><span id="youtube-count">0</span> video 📺</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="youtube-grid"></div>
    </section>

    <!-- ================= SECTION: TRẠM LUYỆN TẬP TỔNG HỢP ================= -->
    <section id="view-arcade" class="hidden space-y-6 max-w-4xl mx-auto">
      
      <!-- MENU CÁC DẠNG BÀI TẬP -->
      <div id="arcade-menu" class="space-y-6 max-w-3xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Dạng 1: Điền từ -->
          <div onclick="startArcadeMode('fill')" class="cursor-pointer bg-white border-2 border-cottage-butter hover:border-cottage-rose rounded-[2rem] p-6 md:p-8 text-center shadow-sm hover:shadow-md transition transform hover:-translate-y-1">
            <div class="text-4xl md:text-5xl mb-4 animate-float">📝</div>
            <h3 class="font-display font-black text-xl text-cottage-brown">Điền từ vào ngữ cảnh</h3>
            <p class="text-xs text-cottage-brownLight mt-3 leading-relaxed">Chọn và điền từ vựng phù hợp vào chỗ trống để hoàn thiện câu thoại.</p>
          </div>
          <!-- Dạng 2: Tìm lỗi sai -->
          <div onclick="startArcadeMode('mistake')" class="cursor-pointer bg-white border-2 border-cottage-butter hover:border-cottage-amber rounded-[2rem] p-6 md:p-8 text-center shadow-sm hover:shadow-md transition transform hover:-translate-y-1">
