    // ================= 7. CẬP TRẠNG THÁI GIAO DIỆN =================
    function applyVipUI(expiryTimestamp) {
      const vipHeaderBtn = document.getElementById('vip-header-btn');
      const isLifetime = expiryTimestamp - Date.now() > 50 * 365 * 24 * 60 * 60 * 1000;
      const textDate = isLifetime ? "Vĩnh viễn" : new Date(expiryTimestamp).toLocaleDateString('vi-VN');

      vipHeaderBtn.innerHTML = '<i class="fa-solid fa-crown text-[11px]"></i> <span>Thành viên VIP 🌟 (Đăng xuất)</span>';
      vipHeaderBtn.classList.remove('bg-white', 'text-cottage-roseDark', 'border-cottage-rose');
      vipHeaderBtn.classList.add('bg-cottage-rose', 'text-white', 'border-transparent');
      
      vipHeaderBtn.onclick = () => {
        const confirmLogout = confirm(`Tài khoản VIP của bạn dùng được đến ngày: ${textDate} 🌷\nBạn có muốn ĐĂNG XUẤT không?`);
        if (confirmLogout) window.handleLogout();
      };
      
      window.closeModal('modal-login');
