            ${(c.locked && !isVip) ? '<div class="absolute inset-0 bg-black/40 flex items-center justify-center backdrop-blur-sm"><span class="bg-white/95 text-cottage-roseDark px-3 py-1.5 rounded-full text-[11px] font-black shadow-lg uppercase tracking-wider"><i class="fa-solid fa-lock mr-1"></i> VIP</span></div>' : '<div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition"></div>'}
          </div>
          <div class="flex-1 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex flex-wrap gap-1">
                 <span class="text-[10px] font-black px-2.5 py-1 rounded-md bg-cottage-butter text-cottage-brown uppercase">${c.genre}</span>
