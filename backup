    window.renderCinemaQuiz = function() {
      const item = cinemaData.find(c => c.id === activeCinemaId);
      if(!item || !item.quizzes || item.quizzes.length === 0) return;
      
      const quiz = item.quizzes[activeQuizIndex];
      document.getElementById('quiz-counter').innerText = `(${activeQuizIndex + 1}/${item.quizzes.length})`;
      document.getElementById('modal-quiz-question').innerHTML = quiz.q;

      const optsContainer = document.getElementById('modal-quiz-options');
      const feedback = document.getElementById('modal-quiz-feedback');
      const nextBtn = document.getElementById('btn-next-quiz');

      feedback.classList.add('hidden'); 
      nextBtn.classList.add('hidden');

      optsContainer.innerHTML = quiz.options.map((opt, idx) => `
        <button onclick="checkCinemaQuiz(${idx}, this)" class="w-full text-left p-4 rounded-2xl bg-white border-2 border-cottage-butter hover:border-cottage-roseLight hover:bg-cottage-roseLight/20 text-sm font-bold text-cottage-brown transition flex items-center justify-between group">
          <span>${opt}</span>
          <div class="w-4 h-4 rounded-full border-2 border-cottage-butter group-hover:border-cottage-rose flex-shrink-0 ml-2"></div>
        </button>
      `).join('');
    };

    window.checkCinemaQuiz = function(chosenIdx, btn) {
      const item = cinemaData.find(c => c.id === activeCinemaId);
      const quiz = item.quizzes[activeQuizIndex];
      const feedback = document.getElementById('modal-quiz-feedback');
      const nextBtn = document.getElementById('btn-next-quiz');
      const { tMain, tHover } = window.modalThemeClasses;
      
      feedback.classList.remove('hidden'); 

      if (chosenIdx === quiz.correct) {
        const allBtns = document.getElementById('modal-quiz-options').querySelectorAll('button');
        allBtns.forEach(b => b.disabled = true);
          
        btn.className = "w-full text-left p-4 rounded-2xl text-sm font-bold flex items-center justify-between bg-cottage-greenLight border-2 border-cottage-green/40 text-cottage-greenDark";
      feedback.className = "p-4 rounded-2xl text-sm font-bold leading-relaxed bg-cottage-greenLight text-cottage-greenDark border-2 border-cottage-green/30 block mt-3 relative z-10";
        feedback.innerHTML = `🎉 <b>Chính xác!</b><br><span class="text-xs font-normal mt-1 block">${quiz.explanation}</span>`;
      } else {
        const allBtns = document.getElementById('modal-quiz-options').querySelectorAll('button');
          
        btn.className = "w-full text-left p-4 rounded-2xl text-sm font-bold flex items-center justify-between bg-cottage-roseLight border-2 border-cottage-rose/40 text-cottage-roseDark";
        allBtns[quiz.correct].className = "w-full text-left p-4 rounded-2xl text-sm font-bold flex items-center justify-between bg-cottage-greenLight border-2 border-cottage-green/40 text-cottage-greenDark";
        feedback.className = "p-4 rounded-2xl text-sm font-bold leading-relaxed bg-cottage-roseLight text-cottage-roseDark border-2 border-cottage-rose/30 block mt-3 relative z-10";
        feedback.innerHTML = `📝 <b>Khoan đã, hãy xem lại video để đoán nghĩa nhé!</b><br><span class="text-xs font-normal mt-1 block">${quiz.explanation}</span>`;
      }
      
      nextBtn.className = `flex-1 w-full py-3.5 text-white font-bold text-sm rounded-2xl shadow-sm transition transform active:scale-95 mt-4 ${tMain} ${tHover}`;
      nextBtn.classList.remove('hidden');

      if (activeQuizIndex === item.quizzes.length - 1) {
        nextBtn.innerHTML = "Tuyệt vời! Đóng bài học";
        nextBtn.onclick = () => {
          document.getElementById('cinema-media-container').innerHTML = ''; 
          window.closeModal('modal-cinema');
        };
      } else {
        nextBtn.innerHTML = "Câu tiếp theo ⏭️";
        nextBtn.onclick = () => { activeQuizIndex++; window.renderCinemaQuiz(); };
