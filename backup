    window.handleAuth = async function() {
      const email = document.getElementById('auth-email').value.trim();
      const password = document.getElementById('auth-password').value.trim();
      const btn = document.getElementById('btn-auth-submit');

      if (!email || password.length < 6) {
        alert("Email không hợp lệ hoặc mật khẩu dưới 6 ký tự!"); return;
      }

      const originalText = btn.innerHTML;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
      btn.disabled = true;
      btn.classList.add('opacity-70', 'cursor-not-allowed');

      try {
        if (isLoginMode) {
          await signInWithEmailAndPassword(auth, email, password);
          alert("Đăng nhập thành công! 🌷");
        } else {
          const userCred = await createUserWithEmailAndPassword(auth, email, password);
          await setDoc(doc(db, "users", userCred.user.uid), {
            email: email,
            vipExpiryDate: "2000-01-01T00:00:00", 
            createdAt: new Date().toISOString()
          });
          alert("Tạo tài khoản thành công! Chúc bạn có một trải nghiệm học tập thật vui cùng Cozy 🌿");
        }
      } catch (error) {
        let friendlyMessage = "Có lỗi xảy ra, vui lòng thử lại!";
       switch (error.code) {
          case 'auth/invalid-credential': 
          case 'auth/user-not-found':
          case 'auth/wrong-password':
              friendlyMessage = "🤔 Email hoặc mật khẩu không chính xác!\n👉 Nếu bạn CHƯA tạo tài khoản, hãy nhấn vào dòng 'Chưa có tài khoản? Đăng ký ngay' ở bên dưới nhé!"; 
              break;
          case 'auth/email-already-in-use': friendlyMessage = "🛑 Email này đã được đăng ký rồi bạn ơi."; break;
          case 'auth/invalid-email': friendlyMessage = "🛑 Định dạng email không đúng (ví dụ chuẩn: cozy@gmail.com)."; break;
          case 'auth/weak-password': friendlyMessage = "🛑 Mật khẩu hơi yếu, hãy chọn mật khẩu dài từ 6 ký tự trở lên."; break;
          case 'auth/network-request-failed': friendlyMessage = "🌐 Lỗi kết nối mạng. Bạn kiểm tra lại Wifi/4G nhé!"; break;
          default: friendlyMessage = "Lỗi hệ thống: " + error.message;
       }
        alert(friendlyMessage);
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('opacity-70', 'cursor-not-allowed');
      }
    };

