         tHoverBorder = 'hover:border-cottage-roseLight';
         tHoverText = 'group-hover:text-cottage-rose';
         tBtnHoverBg = 'group-hover:bg-cottage-roseLight';
         tBtnHoverBorder = 'group-hover:border-cottage-rose';
         tBtnHoverText = 'group-hover:text-cottage-roseDark';
