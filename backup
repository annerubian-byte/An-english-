    // ================= 4. HÀM TẢI VÀ LẮNG NGHE DỮ LIỆU REAL-TIME =================
    async function loadAppData() {
      try {
        const lessonsRef = collection(db, "lessons");
        const practiceRef = collection(db, "practice_sentences");

        const initialSnap = await getDocs(lessonsRef);
        if (initialSnap.empty) {
          document.getElementById('sync-overlay').classList.remove('hidden');
          console.log("Kho dữ liệu trống. Đang tự động đẩy bài học lên Firebase...");
          
          for (const item of SEED_CINEMA_DATA) {
            await setDoc(doc(db, "lessons", `lesson_${item.id}`), item);
          }
          for (const practice of SEED_PRACTICE_DATA) {
            await setDoc(doc(db, "practice_sentences", practice.id), practice);
          }
          
          console.log("Hoàn tất đẩy dữ liệu! Tải lại trang...");
          window.location.reload(); 
          return;
        }

        onSnapshot(lessonsRef, (snapshot) => {
          cinemaData = snapshot.docs.map(doc => ({ firebaseId: doc.id, ...doc.data() }));
          cinemaData.sort((a, b) => a.id - b.id);
          if (document.getElementById('cinema-grid')) {
            window.renderAllSections();
            window.updateAvailableSentences();
            }
          }
        );

        onSnapshot(practiceRef, (snapshot) => {
          allPracticeSentences = snapshot.docs.map(doc => ({ firebaseId: doc.id, ...doc.data() }));
          if (document.getElementById('cinema-grid')) {
            window.updateAvailableSentences();
          }
        });

        document.getElementById('vip-header-btn').innerHTML = '<i class="fa-solid fa-user text-[11px]"></i> <span>Đăng nhập</span>';
        applyGuestUI(); 

      } catch (error) {
        console.error("Lỗi khi tải học liệu:", error);
        alert("Oops! Không thể kết nối với hệ thống. Bạn kiểm tra lại mạng nhé! 🌷");
      }
    }

