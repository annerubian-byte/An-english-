    window.nextCinemaQuiz = function() {
        activeQuizIndex++; 
        window.renderCinemaQuiz();
    };

    // ================= ARCADE HỆ THỐNG ĐA DẠNG BÀI TẬP =================
    window.updateAvailableSentences = function() {
      if(cinemaData.length === 0) return;
      if (isVip) {
        availableSentences = [...allPracticeSentences];
      } else {
        const unlockedCinemaIds = cinemaData.filter(c => !c.locked).map(c => c.id);
        availableSentences = allPracticeSentences.filter(s => unlockedCinemaIds.includes(s.cinemaId));
      }
    };

    window.startArcadeMode = function(mode) {
      if (availableSentences.length === 0) window.updateAvailableSentences();
      currentArcadeMode = mode;
      
      document.getElementById('arcade-menu').classList.add('hidden');
      document.getElementById('arcade-play-area').classList.remove('hidden');

      ['fill', 'mistake', 'match', 'writing', 'speaking'].forEach(m => document.getElementById('game-' + m).classList.add('hidden'));
      document.getElementById('game-' + mode).classList.remove('hidden');
      document.getElementById('arcade-completed-msg').classList.add('hidden');

      const titleEl = document.getElementById('arcade-play-title');
      const descEl = document.getElementById('arcade-play-desc');

      if(mode === 'fill') {
         titleEl.innerText = "Điền từ vào ngữ cảnh";
         descEl.innerText = "Dựa vào các bài đã học, hãy chọn từ phù hợp để điền vào chỗ trống.";
      } else if (mode === 'mistake') {
         titleEl.innerText = "Tìm lỗi sai";
         descEl.innerText = "Tìm các lỗi sai về cấu trúc hoặc ngữ pháp sau đó sửa lại.";
      } else if (mode === 'match') {
         titleEl.innerText = "Ghép đôi cụm từ";
         descEl.innerText = "Nối các mảnh ghép ở hai cột lại để tạo thành Collocation/Idiom có nghĩa.";
      } else if (mode === 'writing') {
         titleEl.innerText = "Viết câu ứng dụng";
         descEl.innerText = "Sử dụng từ vựng đã học để đặt câu riêng cho bạn.";
      } else if (mode === 'speaking') {
         titleEl.innerText = "Shadowing (Nói)";
         descEl.innerText = "Luyện phản xạ và ngữ điệu giống người bản xứ.";
      }

      let pool = allPracticeSentences.filter(s => s.type === mode);
      if (!isVip) {
          pool = pool.filter(s => {
              const lesson = cinemaData.find(c => c.id === s.cinemaId);
              return lesson && !lesson.locked;
          });
      }
      remainingSentences = [...pool];
      currentPractice = null;

      window.loadNextExercise();
    };

    window.backToArcadeMenu = function() {
       document.getElementById('arcade-menu').classList.remove('hidden');
       document.getElementById('arcade-play-area').classList.add('hidden');
    };

    window.restartArcadeMode = function() {
       if(cinemaData.length === 0) { alert("Đang tải dữ liệu, chờ chút nhé..."); return; }
       let pool = allPracticeSentences.filter(s => s.type === currentArcadeMode);
       if (!isVip) {
           pool = pool.filter(s => {
               const lesson = cinemaData.find(c => c.id === s.cinemaId);
               return lesson && !lesson.locked;
           });
       }
       if (pool.length === 0) { alert("Không tìm thấy bài tập cho phần này."); return; }
       
       remainingSentences = [...pool];
       currentPractice = null; 
       
       document.getElementById('arcade-completed-msg').classList.add('hidden');
       document.getElementById('game-' + currentArcadeMode).classList.remove('hidden');
       window.loadNextExercise();
    };

    window.skipArcadeExercise = function() {
      if (currentPractice) {
        remainingSentences = remainingSentences.filter(s => s.id !== currentPractice.id);
        window.loadNextExercise();
      }
    };

    window.loadNextExercise = function() {
      if (currentPractice) {
        remainingSentences = remainingSentences.filter(s => s.id !== currentPractice.id);
      }

      if (remainingSentences.length === 0) {
        document.getElementById('game-' + currentArcadeMode).classList.add('hidden');
        document.getElementById('arcade-completed-msg').classList.remove('hidden');
        
        const msgDesc = document.getElementById('arcade-completed-desc');
        if (isVip) {
            msgDesc.innerText = "Bạn đã hoàn thành xuất sắc toàn bộ thử thách! Hãy thử sức với dạng bài khác hoặc làm lại nhé.";
        } else {
            msgDesc.innerText = "Hãy thử thách bản thân với dạng bài khác hoặc nâng cấp VIP để mở khóa thêm nhiều câu hỏi nhé!";
        }
        return;
      }
      
      const randomIndex = Math.floor(Math.random() * remainingSentences.length);
      currentPractice = remainingSentences[randomIndex];

      if(currentArcadeMode === 'fill') window.initFillGameUI();
      else if(currentArcadeMode === 'mistake') window.initMistakeGameUI();
      else if(currentArcadeMode === 'match') window.initMatchGameUI();
      else if(currentArcadeMode === 'writing') window.initWritingGameUI();
      else if(currentArcadeMode === 'speaking') window.initSpeakingGameUI();
    };
        
    // --- WRITING GAME ---
    window.initWritingGameUI = function() {
        if (!currentPractice) return;
        document.getElementById('writing-prompt').innerText = currentPractice.prompt;
        document.getElementById('writing-textarea').value = '';
        document.getElementById('writing-feedback').classList.add('hidden');
    };
    window.checkWriting = function() {
        document.getElementById('writing-ref').innerText = currentPractice.refAnswer;
        document.getElementById('writing-feedback').classList.remove('hidden');
    };

    // --- GAME 5: SPEAKING & SHADOWING ---
    window.initSpeakingGameUI = function() {
        if (!currentPractice) return;
        document.getElementById('speaking-quote').innerText = '"' + currentPractice.quote + '"';
        document.getElementById('speaking-status').innerText = "Nhấn nút dưới và đọc to câu thoại bằng tiếng Anh...";
        document.getElementById('speaking-status').className = "text-xs font-bold text-cottage-brownLight text-center";
        document.getElementById('speaking-feedback').classList.add('hidden');
        document.getElementById('btn-mic').disabled = false;
        document.getElementById('btn-mic').classList.remove('opacity-50');
    };

    function getBestVoice() {
        const voices = window.speechSynthesis.getVoices();
        return voices.find(v => v.name.includes('Google US English') || v.name.includes('Samantha') || (v.lang === 'en-US' && v.name.toLowerCase().includes('female'))) || voices.find(v => v.lang === 'en-US') || voices[0];
    }

    window.speakQuote = function() {
        if (!currentPractice) return;
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(currentPractice.quote);
            utterance.voice = getBestVoice();
            utterance.lang = 'en-US';
            utterance.rate = 0.9;
            window.speechSynthesis.speak(utterance);
        } else {
            alert("Trình duyệt của bạn không hỗ trợ tính năng đọc mẫu.");
        }
    };

    window.startPronunciationCheck = function() {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        
        if (!SpeechRecognition) {
            alert("Trình duyệt của bạn không hỗ trợ nhận diện giọng nói. Hãy mở bằng Google Chrome hoặc Microsoft Edge nhé! 🌷");
            return;
        }

        const recognition = new SpeechRecognition();
        recognition.lang = 'en-US';
        recognition.interimResults = false;
        recognition.maxAlternatives = 1;

        const statusEl = document.getElementById('speaking-status');
        const feedbackEl = document.getElementById('speaking-feedback');
        const micBtn = document.getElementById('btn-mic');

        statusEl.innerText = "🎙️ Đang nghe... Hãy đọc to câu thoại lên nhé!";
        statusEl.className = "text-xs font-bold text-cottage-roseDark animate-pulse text-center";
        micBtn.disabled = true;
        micBtn.classList.add('opacity-50');
        feedbackEl.classList.add('hidden');

        recognition.start();

        recognition.onresult = function(event) {
            const userSaid = event.results[0][0].transcript.toLowerCase().trim();
            
            const targetQuote = currentPractice.quote.toLowerCase().replace(/[^a-z0-9\s]/gi, '').trim();
            const userSaidClean = userSaid.replace(/[^a-z0-9\s]/gi, '').trim();

            statusEl.innerText = `🗣️ Bạn vừa đọc: "${userSaid}"`;
            statusEl.className = "text-xs font-bold text-cottage-brown text-center";
            
            feedbackEl.classList.remove('hidden');

            if (userSaidClean === targetQuote || targetQuote.includes(userSaidClean) || calculateWordMatch(targetQuote, userSaidClean) >= 0.7) {
                feedbackEl.className = "p-4 rounded-2xl text-sm bg-cottage-greenLight border-2 border-cottage-green/30 text-cottage-greenDark text-center shadow-sm";
                feedbackEl.innerHTML = `✨ <b>Xuất sắc!</b> Phát âm rất chuẩn xác và rõ ràng. Bạn có thể bấm sang câu tiếp theo nhé! 🎉`;
            } else {
                feedbackEl.className = "p-4 rounded-2xl text-sm bg-cottage-roseLight border-2 border-cottage-rose/30 text-cottage-roseDark text-center shadow-sm";
                feedbackEl.innerHTML = `🤔 Gần đúng rồi! Hệ thống nghe thành: <i>"${userSaid}"</i>.<br>👉 Hãy bấm <b>"Nghe mẫu"</b> và thử đọc lại to, rõ âm cuối hơn nhé!`;
            }

            micBtn.disabled = false;
            micBtn.classList.remove('opacity-50');
        };

        recognition.onerror = function() {
            statusEl.innerText = "❌ Không nghe rõ giọng đọc. Bạn thử bấm lại nút ghi âm nhé!";
            statusEl.className = "text-xs font-bold text-cottage-brownLight text-center";
            micBtn.disabled = false;
            micBtn.classList.remove('opacity-50');
        };

        recognition.onspeechend = function() {
            recognition.stop();
        };
    };

    function calculateWordMatch(target, spoken) {
        const targetWords = target.split(/\s+/);
        const spokenWords = spoken.split(/\s+/);
        let matchedCount = 0;
        
        targetWords.forEach(w => {
            if (spokenWords.includes(w)) matchedCount++;
        });
        
        return matchedCount / targetWords.length;
    }
    
    // --- GAME 1: FILL (ĐIỀN TỪ) ---
    window.initFillGameUI = function() {
      if (!currentPractice) return;
      fillSelectedAnswers = {};
      const promptContainer = document.getElementById('fill-prompt');
      promptContainer.innerHTML = '';
      
      currentPractice.parts.forEach((part, index) => {
        if (part.isBlank) {
          const blankContainer = document.createElement('span');
          blankContainer.className = "inline-flex flex-col items-center mx-1 align-bottom";
          const hintSpan = document.createElement('span');
          hintSpan.className = "text-[11px] md:text-xs text-cottage-brownLight font-normal mb-1 bg-white px-2.5 py-0.5 rounded-md shadow-sm border border-cottage-butter whitespace-nowrap";
          hintSpan.innerText = part.text; 
          const blankSpan = document.createElement('span');
          blankSpan.id = `blank-${index}`;
          blankSpan.className = "inline-block min-w-[80px] px-2 h-10 border-b-2 border-dashed border-cottage-roseDark/50 text-center text-cottage-rose text-sm md:text-base font-bold cursor-pointer transition-colors flex items-center justify-center";
          blankSpan.onclick = () => window.returnWordToPool(index);

          blankContainer.appendChild(hintSpan);
          blankContainer.appendChild(blankSpan);
          promptContainer.appendChild(blankContainer);
        } else {
          const textNode = document.createElement('span');
          textNode.className = "inline-block align-bottom pb-1.5 text-sm md:text-base font-medium";
          textNode.innerText = part.text;
          promptContainer.appendChild(textNode);
        }
      });

      const pool = document.getElementById('fill-pool');
      const shuffledWords = [...currentPractice.wordsToPick].sort(() => 0.5 - Math.random());
      pool.innerHTML = shuffledWords.map(w => 
        `<button id="pool-word-${w.replace(/\s+/g, '-')}" onclick="pickWordForBlank('${w}')" class="px-5 py-2.5 bg-white border-2 border-cottage-butter rounded-xl text-sm md:text-base font-bold text-cottage-brown hover:border-cottage-roseLight hover:bg-cottage-roseLight/20 transition transform active:scale-95 shadow-sm m-1">${w}</button>`
      ).join('');
      
      document.getElementById('fill-feedback').classList.add('hidden');
    };

    window.pickWordForBlank = function(word) {
      let firstEmptyBlankIdx = -1;
      for (let i = 0; i < currentPractice.parts.length; i++) {
        if (currentPractice.parts[i].isBlank && !fillSelectedAnswers[i]) {
          firstEmptyBlankIdx = i; break;
        }
      }
      if (firstEmptyBlankIdx !== -1) {
        fillSelectedAnswers[firstEmptyBlankIdx] = word;
        const blankEl = document.getElementById(`blank-${firstEmptyBlankIdx}`);
        blankEl.innerText = word;
        blankEl.classList.add('border-solid', 'bg-cottage-roseLight/30', 'rounded-t-md');
        document.getElementById(`pool-word-${word.replace(/\s+/g, '-')}`).style.display = 'none';
        
        let isFull = true;
        currentPractice.parts.forEach((part, idx) => {
          if (part.isBlank && !fillSelectedAnswers[idx]) isFull = false;
        });
        
        if (isFull) {
           window.checkFillGame();
        } else {
           document.getElementById('fill-feedback').classList.add('hidden');
        }
      }
    };

    window.returnWordToPool = function(blankIndex) {
      if (fillSelectedAnswers[blankIndex]) {
        const word = fillSelectedAnswers[blankIndex];
        delete fillSelectedAnswers[blankIndex];
        const blankEl = document.getElementById(`blank-${blankIndex}`);
        blankEl.innerText = '';
        blankEl.classList.remove('border-solid', 'bg-cottage-roseLight/30', 'rounded-t-md');
        document.getElementById(`pool-word-${word.replace(/\s+/g, '-')}`).style.display = 'inline-block';
        document.getElementById('fill-feedback').classList.add('hidden');
      }
    };
    
    window.checkFillGame = function() {
      let isCorrect = true;

      currentPractice.parts.forEach((part, idx) => {
        if (part.isBlank) {
          if (fillSelectedAnswers[idx] !== part.expectedWord) isCorrect = false;
        }
      });

      const fb = document.getElementById('fill-feedback'); 
      fb.classList.remove('hidden');

      if (isCorrect) {
        fb.className = "text-sm md:text-base font-bold text-cottage-greenDark block mt-4 text-center animate-bounce"; 
        fb.innerText = "✨ Chính xác! Đang chuyển sang câu tiếp theo...";
        remainingSentences = remainingSentences.filter(s => s.id !== currentPractice.id);
        
        currentPractice.parts.forEach((part, idx) => {
           if(part.isBlank) {
               const b = document.getElementById(`blank-${idx}`);
               if(b) b.onclick = null;
           }
        });

        setTimeout(() => window.loadNextExercise(), 1500);
      } else {
        fb.className = "text-sm md:text-base font-bold text-cottage-roseDark block mt-4 text-center"; 
        fb.innerText = "🤔 Vẫn còn từ chưa chính xác, hãy nhấp vào từ bị sai để trả về và chọn lại nhé!";
      }
    };

    // --- GAME 2: MISTAKE (TÌM LỖI SAI) ---
    window.initMistakeGameUI = function() {
      if (!currentPractice) return;
      const promptBox = document.getElementById('mistake-prompt');
      document.getElementById('mistake-options-box').classList.add('hidden');
      document.getElementById('mistake-feedback').classList.add('hidden');
      document.getElementById('btn-next-mistake').classList.add('hidden');
      document.getElementById('btn-skip-mistake').classList.remove('hidden');

      promptBox.innerHTML = currentPractice.parts.map((p, idx) => {
          if(p.isTarget || p.isError) {
             return `<button onclick="checkMistakeTarget(${idx}, this)" class="inline-block px-1.5 py-0.5 mx-0.5 bg-cottage-cream border-b-2 border-cottage-amberDark hover:bg-cottage-amber/20 font-bold transition rounded-t-md text-cottage-amberDark">${p.text}</button>`;
          }
          return `<span class="inline-block px-1">${p.text}</span>`;
      }).join('');
    };

    window.checkMistakeTarget = function(idx, btn) {
      const part = currentPractice.parts[idx];
      const feedback = document.getElementById('mistake-feedback');
      const optBox = document.getElementById('mistake-options-box');
      
      document.querySelectorAll('#mistake-prompt button').forEach(b => {
          b.classList.remove('bg-cottage-amber/30', 'ring-2', 'ring-cottage-amber');
      });
      btn.classList.add('bg-cottage-amber/30', 'ring-2', 'ring-cottage-amber');

      if (!part.isError) {
          feedback.innerHTML = `<span class="text-sm md:text-base text-cottage-brownLight bg-white border border-cottage-butter px-4 py-3 rounded-xl block shadow-sm"><i class="fa-solid fa-circle-check text-cottage-green mr-1"></i> Từ <b>"${part.text.trim()}"</b> dùng đúng rồi, hãy tìm từ khác nhé!</span>`;
          feedback.classList.remove('hidden');
          optBox.classList.add('hidden');
      } else {
          feedback.classList.add('hidden');
          optBox.classList.remove('hidden');
          document.getElementById('mistake-options').innerHTML = part.fixOptions.map(opt => 
             `<button onclick="submitMistakeFix('${opt}')" class="px-5 py-2.5 bg-white border-2 border-cottage-amber hover:bg-cottage-amber/20 text-cottage-brown rounded-xl text-sm font-bold shadow-sm transition active:scale-95 m-1">${opt}</button>`
          ).join('');
      }
    };

    window.submitMistakeFix = function(selectedFix) {
      const part = currentPractice.parts.find(p => p.isError);
      const feedback = document.getElementById('mistake-feedback');
      const optBox = document.getElementById('mistake-options-box');
      
      feedback.classList.remove('hidden');
      
      if (selectedFix === part.correctFix) {
          optBox.classList.add('hidden');
          feedback.innerHTML = `<div class="bg-cottage-greenLight p-4 rounded-xl border border-cottage-green/30 text-left"><span class="text-cottage-greenDark font-bold text-sm md:text-base mb-1 block"><i class="fa-solid fa-party-horn"></i> Chính xác!</span><span class="text-sm text-cottage-brown">${currentPractice.explanation}</span></div>`;
          document.getElementById('btn-skip-mistake').classList.add('hidden');
          document.getElementById('btn-next-mistake').classList.remove('hidden');
          remainingSentences = remainingSentences.filter(s => s.id !== currentPractice.id);
      } else {
          feedback.innerHTML = `<span class="text-sm md:text-base text-cottage-roseDark bg-cottage-roseLight px-4 py-3 rounded-xl block shadow-sm border border-cottage-rose/20"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Phương án <b>"${selectedFix}"</b> chưa hợp lý. Bạn chọn lại nhé!</span>`;
      }
    };

    // --- GAME 3: MATCH (GHÉP ĐÔI) ---
    window.initMatchGameUI = function() {
       if (!currentPractice) return;
       matchState = { left: null, right: null, completed: [] };
       document.getElementById('match-feedback').classList.add('hidden');
       document.getElementById('btn-next-match').classList.add('hidden');
       document.getElementById('btn-skip-match').classList.remove('hidden');

       const leftCol = document.getElementById('match-left-col');
       const rightCol = document.getElementById('match-right-col');

       const leftItems = currentPractice.pairs.map((p, i) => ({text: p.left, id: i})).sort(() => Math.random() - 0.5);
       const rightItems = currentPractice.pairs.map((p, i) => ({text: p.right, id: i})).sort(() => Math.random() - 0.5);

       leftCol.innerHTML = leftItems.map(item => 
          `<button id="match-L-${item.id}" onclick="selectMatch('L', ${item.id})" class="w-full p-4 bg-white border-2 border-cottage-butter rounded-xl text-sm md:text-base font-bold text-cottage-brown hover:border-cottage-green shadow-sm transition text-right break-words">${item.text}</button>`
       ).join('');
       
       rightCol.innerHTML = rightItems.map(item => 
          `<button id="match-R-${item.id}" onclick="selectMatch('R', ${item.id})" class="w-full p-4 bg-white border-2 border-cottage-butter rounded-xl text-sm md:text-base font-bold text-cottage-brown hover:border-cottage-green shadow-sm transition text-left break-words">${item.text}</button>`
       ).join('');
    };

    window.selectMatch = function(side, id) {
       if (matchState.completed.includes(id)) return;

       const btnId = `match-${side}-${id}`;
       const btn = document.getElementById(btnId);

       if (side === 'L' && matchState.left === id) { matchState.left = null; btn.classList.remove('bg-cottage-greenLight', 'border-cottage-green'); return; }
       if (side === 'R' && matchState.right === id) { matchState.right = null; btn.classList.remove('bg-cottage-greenLight', 'border-cottage-green'); return; }

       if (side === 'L') {
           if(matchState.left !== null) document.getElementById(`match-L-${matchState.left}`).classList.remove('bg-cottage-greenLight', 'border-cottage-green');
           matchState.left = id;
       } else {
           if(matchState.right !== null) document.getElementById(`match-R-${matchState.right}`).classList.remove('bg-cottage-greenLight', 'border-cottage-green');
           matchState.right = id;
       }
       
       btn.classList.add('bg-cottage-greenLight', 'border-cottage-green');

       if (matchState.left !== null && matchState.right !== null) {
           if (matchState.left === matchState.right) {
               const correctId = matchState.left;
               const btnL = document.getElementById(`match-L-${correctId}`);
               const btnR = document.getElementById(`match-R-${correctId}`);
               
               btnL.className = "w-full p-4 bg-cottage-green border-2 border-transparent rounded-xl text-sm md:text-base font-bold text-white shadow-sm transition text-right opacity-80 cursor-default scale-95";
               btnR.className = "w-full p-4 bg-cottage-green border-2 border-transparent rounded-xl text-sm md:text-base font-bold text-white shadow-sm transition text-left opacity-80 cursor-default scale-95";
               
               matchState.completed.push(correctId);
               matchState.left = null;
               matchState.right = null;

               if (matchState.completed.length === currentPractice.pairs.length) {
                   const fb = document.getElementById('match-feedback');
                   fb.classList.remove('hidden');
                   fb.innerHTML = `<span class="text-cottage-greenDark font-bold animate-bounce block text-center">🎉 Tuyệt vời! Bạn đã nối đúng toàn bộ!</span>`;
                   document.getElementById('btn-skip-match').classList.add('hidden');
                   document.getElementById('btn-next-match').classList.remove('hidden');
                   remainingSentences = remainingSentences.filter(s => s.id !== currentPractice.id);
               }
           } else {
               const bL = document.getElementById(`match-L-${matchState.left}`);
               const bR = document.getElementById(`match-R-${matchState.right}`);
               
               bL.classList.remove('bg-cottage-greenLight', 'border-cottage-green');
               bR.classList.remove('bg-cottage-greenLight', 'border-cottage-green');
               bL.classList.add('bg-cottage-roseLight', 'border-cottage-rose');
               bR.classList.add('bg-cottage-roseLight', 'border-cottage-rose');
               
               setTimeout(() => {
                   bL.classList.remove('bg-cottage-roseLight', 'border-cottage-rose');
                   bR.classList.remove('bg-cottage-roseLight', 'border-cottage-rose');
               }, 500);

               matchState.left = null;
               matchState.right = null;
           }
       }
    };

    // ================= 9. KHỞI CHẠY =================
    window.addEventListener('DOMContentLoaded', () => {
      loadAppData(); 
      const initialHash = window.location.hash.replace('#', '') || 'cinema';
      handleViewSwitch(initialHash);
    });
  </script>
