              </div>
              <h3 class="font-display font-bold text-base text-cottage-brown ${tHoverText} transition line-clamp-1">${c.title}</h3>
            </div>
            <button class="mt-4 w-full py-2 bg-cottage-cream border-2 border-cottage-butter rounded-xl text-xs font-bold text-cottage-brown ${tBtnHoverBg} ${tBtnHoverBorder} ${tBtnHoverText} transition">
              ${(c.locked && !isVip) ? 'Mở khóa ngay 🗝️' : 'Vào học ngay 🎬'}
