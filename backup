         tBtnHoverBg = 'group-hover:bg-cottage-amberLight';
         tBtnHoverBorder = 'group-hover:border-cottage-amber/50';
         tBtnHoverText = 'group-hover:text-cottage-amberDark';
      } else if (format === 'youtube') {
         tHoverCardBg = 'hover:bg-cottage-greenLight/30';
         tHoverBorder = 'hover:border-cottage-green/50';
         tHoverText = 'group-hover:text-cottage-greenDark';
         tBtnHoverBg = 'group-hover:bg-cottage-greenLight';
         tBtnHoverBorder = 'group-hover:border-cottage-green/50';
         tBtnHoverText = 'group-hover:text-cottage-greenDark';
