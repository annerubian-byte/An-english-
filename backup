    function startRealtimeVipCheck(uid) {
      const userRef = doc(db, "users", uid);
      userDocListener = onSnapshot(userRef, (userSnap) => {
        if (userSnap.exists()) {
          const data = userSnap.data();
          let expTime = 0;
          
          if (data.vipExpiryDate) {
            if (typeof data.vipExpiryDate === 'object' && data.vipExpiryDate.toDate) {
              expTime = data.vipExpiryDate.toDate().getTime(); 
            } else {
              const dateStr = String(data.vipExpiryDate).trim();
              if (dateStr.includes('/')) {
                const parts = dateStr.split('/');
                if (parts.length === 3) expTime = new Date(`${parts[2]}-${parts[1]}-${parts[0]}T23:59:59`).getTime();
              } else {
                expTime = new Date(dateStr).getTime(); 
              }
            }
          }

          currentVipExpiry = isNaN(expTime) ? 0 : expTime;

          if (currentVipExpiry > Date.now()) {
            isVip = true;
            applyVipUI(currentVipExpiry);
            startVipTimer();
          } else {
            isVip = false;
            if (vipTimer) clearInterval(vipTimer);
            applyExpiredUI();
            kickIfInVipCinema();
          }
        } else {
          isVip = false;
          if (vipTimer) clearInterval(vipTimer);
          applyExpiredUI();
          kickIfInVipCinema();
        }

        if(cinemaData.length > 0) {
           window.renderAllSections();
           window.updateAvailableSentences();
        }
      });
    }

    function kickIfInVipCinema() {
      const modalCinema = document.getElementById('modal-cinema');
      if (modalCinema && !modalCinema.classList.contains('hidden') && activeCinemaId) {
        const activeItem = cinemaData.find(c => c.id === activeCinemaId);
        if (activeItem && activeItem.locked) {
          window.closeModal('modal-cinema');
          alert("⏳ Thời gian VIP của bạn đã kết thúc. Vui lòng đăng ký lại để xem tiếp nhé 🌷");
          window.openVipModal();
        }
      }
    }

    function startVipTimer() {
        if (vipTimer) clearInterval(vipTimer);
        vipTimer = setInterval(() => {
            if (isVip && Date.now() > currentVipExpiry) {
                isVip = false;
                clearInterval(vipTimer); 
                applyExpiredUI(); 
                if(cinemaData.length > 0) {
                    window.renderAllSections(); 
                    window.updateAvailableSentences();
                }
                kickIfInVipCinema();
            }
        }, 5000); 
    }

